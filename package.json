{
  "name": "solar-syndicate",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @solsyn/web build",
    "dev": "pnpm --filter @solsyn/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "verify": "pnpm --filter @solsyn/web build && node scripts/verify.mjs",
    "shots": "pnpm --filter @solsyn/web build && node scripts/capture-shots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
